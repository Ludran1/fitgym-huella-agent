<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HuellaAgent</RootNamespace>
    <AssemblyName>HuellaAgent</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Versión del agente: el launcher (launch.ps1) la compara contra el tag del último
         release en GitHub para auto-actualizar. Subir esto en cada release nuevo. -->
    <Version>1.0.0</Version>
    <!-- El agente es Windows en produccion, pero compila/testea en Linux (MockDevice). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <!-- DPAPI para cifrar el token de pairing en disco (Windows). En Linux/dev se guarda plano. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- SDK ZKFinger REAL: solo al publicar para Windows x64. Define ZKFP (compila ZkfpDevice)
       y referencia el wrapper oficial. En Linux/CI (sin RID) NO se referencia ni compila →
       el build y los tests siguen siendo cross-platform con MockDevice. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <DefineConstants>$(DefineConstants);ZKFP</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Reference Include="libzkfpcsharp">
      <HintPath>sdk/win-x64/libzkfpcsharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
